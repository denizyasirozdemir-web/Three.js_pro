; Engine configuration file.
; Kessler Works - a first-person industrial horror game.

config_version=5

[application]

config/name="Kessler Works"
config/description="Plant 9 has been dark for forty years. Tonight, you turn the lights back on."
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/Game.gd"
Sfx="*res://scripts/autoload/Sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
